omotionTimeEn":"","promotionTimeTc":"","promotionTimeSc":"","promotionImageUrlEn":"/linkweb/api/file/SiteAssets/Promotion/2026/05/06/cms.jpg?v=c5bc7815563e2f9b1ea54c794fbc5256","promotionImageUrlTc":"/linkweb/api/file/SiteAssets/Promotion/2026/05/06/cms.jpg?v=c5bc7815563e2f9b1ea54c794fbc5256","promotionImageUrlSc":"/linkweb/api/file/SiteAssets/Promotion/2026/05/06/cms.jpg?v=c5bc7815563e2f9b1ea54c794fbc5256"}],"mallDescription":{"descriptionTitleEn":"","descriptionTitleTc":"","descriptionTitleSc":"","descriptionContentEn":"Conveniently located near Yau Tong MTR station, Lei Yue Mun Plaza attracts residents of nearby Yau Tong Estate, Yau Mei Court and Ko Cheung Court as well as the area’s other residents. With shops, restaurants, supermarkets, fresh market and a vast array of other services, Lei Yue Mun Plaza fulfills every need. \n\nLei Yue Mun Plaza offers a comfortable shopping experience. Its skylights bathe the shopping centre in soothing natural light. There is a two-story high atrium, which offers ample open space for exciting events and promotions.\n\n","descriptionContentTc":"坐落在油塘地鐵站旁，鯉魚門商場為油塘邨、油美苑、高翔苑和區內的居民提供一站式購物消閒選擇。內設商店、食肆、超級市場、街市和其它服務，滿足您的日常需要。\n\n鯉魚門商場裝有氣派天窗，帶來明媚的自然陽光，透射商場每一角落，搭配兩層高的雅緻中庭，為未來的活動及宣傳提供充裕空間。\n\n\n","descriptionContentSc":"坐落在油塘地铁站旁，鲤鱼门商场为油塘邨、油美苑、高翔苑和区内的居民提供一站式购物消闲选择。内设商店、食肆、超级市场、街市和其它服务，满足您的日常需要。\n\n鲤鱼门商场装有气派天窗，带来明媚的自然阳光，透射商场每一角落，搭配两层高的雅致中庭，为未来的活动及宣传提供充裕空间。\n\n\n"},"mallInfo":{"shopCentreId":24,"propertyTypeId":2,"addressLabelEn":"Address","addressLabelTc":"地址","addressLabelSc":"地址","addressEn":"Lei Yue Mun Plaza 80 Lei Yue Mun Road Yau Tong,  Kwun Tong, Kowloon","addressTc":"九龍觀塘油塘鯉魚門道80號鯉魚門廣場","addressSc":"九龙观塘油塘鲤鱼门道80号鲤鱼门广场","customerHotLineLabelEn":"Customer Service Hotline","customerHotLineLabelTc":"客戶服務熱線","customerHotLineLabelSc":"客户服务热线","customerHotLine":"(852) 3194 0118","carParkEnquiryLabelEn":"Car Park Enquiry","carParkEnquiryLabelTc":"停車場查詢","carParkEnquiryLabelSc":"停车场查询","carParkEnquiry":"3194 0118","leasingEnquiryLabelEn":"